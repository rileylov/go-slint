import { Button, VerticalBox } from "std-widgets.slint";

export global Logic {
    pure callback greeting(string) -> string;
}

export component AppWindow inherits Window {
    in-out property <string> name: "World";
    in-out property <int> clicks: 0;
    in-out property <[string]> log;
    callback clicked();

    title: "Typed Hello";
    preferred-width: 340px;
    preferred-height: 260px;

    VerticalBox {
        alignment: center;
        spacing: 10px;
        Text { text: Logic.greeting(root.name); horizontal-alignment: center; font-size: 22px; }
        Text { text: "clicks: " + root.clicks; horizontal-alignment: center; color: #888; }
        Button { text: "Click me"; clicked => { root.clicked(); } }
        for entry in root.log : Text { text: entry; horizontal-alignment: center; color: #44aa88; }
    }
}
